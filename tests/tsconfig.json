{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": ["ES2020"],
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "moduleResolution": "node",
        "noEmit": true,
        "baseUrl": "..",
        "paths": {
            "@/*": ["src/*"],
            "@tests/*": ["tests/*"]
        }
    },
    "include": ["./**/*"],
    "references": [{ "path": ".." }]
}
