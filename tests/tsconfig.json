{
    "compilerOptions": {
        "target": "ES2021",
        "module": "node18",
        "lib": ["ES2022"],
        "types": ["node"],
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "exactOptionalPropertyTypes": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "moduleResolution": "node16",
        "noEmit": true,
        "paths": {
            "@/*": ["../src/*"],
            "@tests/*": ["./*"]
        }
    },
    "include": ["./**/*"]
}
