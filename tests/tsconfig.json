{
    "compilerOptions": {
        "target": "ES2021",
        "module": "commonjs",
        "lib": ["ES2021"],
        "types": ["node"],
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "moduleResolution": "node10",
        "ignoreDeprecations": "6.0",
        "noEmit": true,
        "paths": {
            "@/*": ["../src/*"],
            "@tests/*": ["./*"]
        }
    },
    "include": ["./**/*"]
}
