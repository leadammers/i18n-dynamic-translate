{
  "name": "i18n-dynamic-translate",
  "version": "0.1.0",
  "description": "Automatic translation library for i18next and Node.js i18n with support for DeepL and LibreTranslate.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:deepl-e2e": "vitest run tests/e2e/deepl.test.ts",
    "prepublishOnly": "npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "i18n",
    "i18next",
    "translation",
    "auto-translate",
    "metadata",
    "api-translation",
    "dynamic-content",
    "runtime-translation",
    "localization",
    "internationalization"
  ],
  "author": "Lea Dammers",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/i18n": "^0.13.12",
    "@types/i18next": "^13.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "dotenv": "^17.2.3",
    "i18n": "^0.15.3",
    "i18next": "^23.7.0",
    "prettier": "^3.7.1",
    "typescript": "^5.5.3",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "i18n": "^0.15.0",
    "i18next": "^23.0.0"
  },
  "peerDependenciesMeta": {
    "i18n": {
      "optional": true
    },
    "i18next": {
      "optional": true
    }
  }
}
